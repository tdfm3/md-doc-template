{
  "name": "md-doc-template",
  "version": "1.0.0",
  "description": "Markdown で書いたドキュメントを VuePress でビルドし、GitHub Pages に公開するためのテンプレートリポジトリです。",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "vuepress dev docs",
    "build": "vuepress build docs",
    "textlint": "textlint docs/**/*.md",
    "textlint:fix": "textlint --fix docs/**/*.md",
    "prepare": "lefthook install || exit 0"
  },
  "devDependencies": {
    "@vuepress/bundler-vite": "^2.0.0-rc.24",
    "@vuepress/plugin-icon": "^2.0.0-rc.120",
    "@vuepress/plugin-markdown-chart": "^2.0.0-rc.109",
    "@vuepress/plugin-markdown-ext": "^2.0.0-rc.112",
    "@vuepress/plugin-markdown-image": "^2.0.0-rc.121",
    "@vuepress/plugin-markdown-tab": "^2.0.0-rc.121",
    "@vuepress/plugin-search": "^2.0.0-rc.112",
    "@vuepress/theme-default": "^2.0.0-rc.24",
    "lefthook": "^2.0.8",
    "mermaid": "^11.12.0",
    "sass-embedded": "^1.93.2",
    "textlint": "^15.4.1",
    "textlint-filter-rule-allowlist": "^4.0.0",
    "textlint-filter-rule-comments": "^1.2.2",
    "textlint-rule-preset-ja-engineering-paper": "^1.0.4",
    "textlint-rule-preset-ja-technical-writing": "^12.0.2",
    "vite": "^7.1.9",
    "vuepress": "^2.0.0-rc.24"
  },
  "dependencies": {
    "@snippetors/vuepress-plugin-code-copy": "^1.2.3"
  }
}
